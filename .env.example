# ── Required in production ────────────────────────────────────────────

# The site's public address. Used for the cross-site request check, sitemap and metadata.
SITE_URL=https://www.example.com

# Admin accounts for /admin: name:hash pairs separated by commas.
# Create each entry with:  npm run admin:hash -- Sam
# Plain-text passwords (Sam:some-password) only work outside production.
ADMIN_USERS=

# Signs admin session cookies. At least 32 characters. Changing it signs every admin out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Database for admin edits, reviews, enquiries, the coming-soon list and rate limits.
# On Vercel, add Upstash Redis from the Marketplace; it sets KV_REST_API_URL/KV_REST_API_TOKEN, which also work.
# Without a database on Vercel the site runs read-only with the built-in listings.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shown on the privacy and terms pages.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Optional ──────────────────────────────────────────────────────────

# Key prefix, so staging and production can share one Redis database safely.
# STORE_PREFIX=near-to-me

# Local file storage when no database is configured (defaults to ./.data). Not used on Vercel.
# CONTENT_DIR=/var/lib/near-to-me

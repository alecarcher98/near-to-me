# Admin accounts for /admin, as name:password pairs separated by commas.
# Use long, unique passwords. Names are case-insensitive.
ADMIN_USERS=Sam:change-me-to-a-long-password,Priya:another-long-password

# Signs admin session cookies. At least 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Where admin edits, reviews and business enquiries are saved (defaults to ./.data).
# CONTENT_DIR=/var/lib/near-to-me
